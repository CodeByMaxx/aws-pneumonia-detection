{
    "environment": "local",

    "dataset": {
        "path": "data/raw/chest_xray",
        "train": "train",
        "validation": "val",
        "test": "test"
    },

    "model": {
        "path": "models/pneumonia_model.keras"
    },

    "training": {
        "epochs": 10,
        "batch_size": 2,
        "image_size": [
            160,
            160
        ],
        "learning_rate": 0.0001,
        "transfer_learning": true,
        "fine_tuning": false
    },

    "hardware": {
        "device": "gpu",
        "mixed_precision": false
    },

    "aws": {
        "enabled": false,
        "region": "eu-central-1",
        "bucket": "",
        "s3_key": ""
    },

    "inference": {
        "confidence_threshold": 0.5
    }
}
