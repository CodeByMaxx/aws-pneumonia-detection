{
    "environment": "aws",

    "dataset": {
        "path": "data/raw/chest_xray",
        "train": "train",
        "validation": "val",
        "test": "test"
    },

    "model": {
        "path": "models/pneumonia_model.keras"
    },

    "training": {
        "epochs": 20,
        "batch_size": 64,
        "image_size": [
            224,
            224
        ],
        "learning_rate": 0.00005,
        "transfer_learning": true,
        "fine_tuning": true
    },

    "hardware": {
        "device": "gpu",
        "mixed_precision": true
    },

    "aws": {
        "enabled": true,

        "region": "eu-central-1",

        "bucket": "codebymaxx-pneumonia-models",

        "s3_key": "models/pneumonia_model.keras"
    },

    "inference": {
        "confidence_threshold": 0.5
    }
}
